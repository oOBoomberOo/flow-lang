{
  "name": "flow",
  "version": "0.9.0",
  "description": "Flow: a tierless language with a type-inferred client/server boundary",
  "type": "module",
  "bin": { "flow": "./bin/flow.mjs" },
  "engines": { "node": ">=22.6" },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "node bin/flow.mjs build examples/counter.flow --out dist",
    "package:extension": "node scripts/build-vsix.mjs",
    "extension:install": "node scripts/build-vsix.mjs && code --install-extension build/flow-language.vsix --force"
  },
  "license": "MIT",
  "private": true
}
