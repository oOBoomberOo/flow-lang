// flow-charts 1.0.0 — a tiny, dependency-free bar chart.

use std::list::{map, fold}
use std::math::maxInt

pub fn Bar(props: { label: Str, value: Int, max: Int }) -> Html {
  html {
    <div class="bar">
      <span class="bar-label">{props.label}</span>
      <span class="bar-track">
        <span class="bar-fill" style={width(props.value, props.max)}></span>
      </span>
      <span class="bar-value">{props.value}</span>
    </div>
  }
}

fn width(value: Int, max: Int) -> Str {
  let pct = if (max <= 0) { 0 } else { (value * 100) / max };
  "width:" + str(pct) + "%"
}

fn maxOf(xs: List<Int>) -> Int {
  fold(xs, 1, fn(acc: Int, x: Int) -> Int { maxInt(acc, x) })
}

pub fn Chart(props: { title: Str, bars: List<(Str, Int)> }) -> Html {
  let values = map(props.bars, fn(b: (Str, Int)) -> Int { b.1 });
  let top = maxOf(values);
  html {
    <figure class="chart">
      <figcaption class="chart-title">{props.title}</figcaption>
      {map(props.bars, fn(b: (Str, Int)) -> Html {
        html { <Bar label={b.0} value={b.1} max={top} /> }
      })}
    </figure>
  }
}
