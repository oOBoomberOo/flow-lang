module Flow.Server (log, now, random, state) where

-- Server-side authority. Each body performs a server-only primitive, so the
-- function is placed on the server and calling it from the client is a cut.

foreign import js unsafe "__flow.host.log" {
  server_write :: Str -> () @server
}

foreign import js unsafe "__flow.host.now" {
  server_now :: () -> Int @server
}

foreign import js unsafe "Math.random" {
  server_random :: () -> Float @server
}

log :: Str -> ()
log msg = server_write msg

now :: () -> Int
now () = server_now ()

random :: () -> Float
random () = server_random ()

-- A server-bound cell: the state lives in the server process and is shared by
-- its readers. It may be declared at the top level or created in a local scope:
--
--   counter :: Cell Int @server
--   counter = Server.state 0
--
-- Client reads become reactive cuts (the server pushes the current value when
-- it changes); client writes become call cuts. The cell itself crosses as a
-- handle, so `Server.state` is also valid inside client code.
foreign import js unsafe "__flow.host.cell" {
  server_cell :: a -> Cell a @server
}

state :: a -> Cell a @server
state init = server_cell init
