module Flow.Result where

-- Flow.Result - `Result e a`: a value that either succeeded (`Ok a`) or failed
-- with an error `e`. The error type comes first, so `Result e` is a functor and
-- monad over the success value, exactly like Haskell's `Either e`.
--
-- Use it for parsing and validation, where an error message must survive:
--
--   import Result
--   case Result.parse (int) "12x" of
--     Ok n -> str n
--     Err why -> "bad number: " + why

data Result e a = Ok a | Err e

isOk :: Result e a -> Bool
isOk r = case r of
  Ok _ -> True
  Err _ -> False

isErr :: Result e a -> Bool
isErr r = case r of
  Ok _ -> False
  Err _ -> True

mapOk :: (a -> b) -> Result e a -> Result e b
mapOk f r = case r of
  Ok a -> Ok (f a)
  Err e -> Err e

mapError :: (e -> f) -> Result e a -> Result f a
mapError f r = case r of
  Ok a -> Ok a
  Err e -> Err (f e)

andThen :: (a -> Result e b) -> Result e a -> Result e b
andThen f r = case r of
  Ok a -> f a
  Err e -> Err e

withDefault :: a -> Result e a -> a
withDefault fallback r = case r of
  Ok a -> a
  Err _ -> fallback

toOption :: Result e a -> Option a
toOption r = case r of
  Ok a -> Some a
  Err _ -> None

fromOption :: e -> Option a -> Result e a
fromOption err o = case o of
  Some a -> Ok a
  None -> Err err

-- Both values must succeed; the first failure short-circuits.
map2 :: (a -> b -> c) -> Result e a -> Result e b -> Result e c
map2 f ra rb = case ra of
  Ok a -> case rb of
    Ok b -> Ok (f a b)
    Err e -> Err e
  Err e -> Err e

-- Turn a list of results into a result of a list.
all :: List (Result e a) -> Result e (List a)
all rs =
  let go acc rest = case rest of
        [] -> Ok (reverse acc)
        r : more -> case r of
          Ok a -> go (a : acc) more
          Err e -> Err e
  in go [] rs

-- Pick the first success, remembering the last error if everything failed.
first :: List (Result e a) -> Result e a
first rs = case rs of
  [] -> Err (errPlaceholder ())
  Ok a : _rest -> Ok a
  Err _e : rest -> first rest

-- `first` needs a value of the error type when the list is empty; callers with a
-- sensible default should use `firstOr`.
firstOr :: e -> List (Result e a) -> Result e a
firstOr fallback rs = case rs of
  [] -> Err fallback
  Ok a : _rest -> Ok a
  Err _e : rest -> firstOr fallback rest

errPlaceholder :: () -> e
errPlaceholder () = errPlaceholder ()
