module Env (get, getOr, exists, all, args, name, platform, vars) where

-- std::env — the process environment. Server-side only: a browser has no
-- environment, so these functions are placed on the server by their FFI leaves.

foreign import js unsafe "__flow.host.envGet" host_env_get :: Str -> Option Str @server

foreign import js unsafe "__flow.host.envVars" host_env_vars :: () -> List (Str, Str) @server

foreign import js unsafe "__flow.host.envArgs" host_env_args :: () -> List Str @server

foreign import js unsafe "__flow.host.envName" host_env_name :: () -> Str @server

foreign import js unsafe "__flow.host.envPlatform" host_env_platform :: () -> Str @server

-- `Some value` when the variable is set (and not empty).
get :: Str -> Option Str
get key = host_env_get key

getOr :: Str -> Str -> Str
getOr fallback key = Option.withDefault (host_env_get key) fallback

exists :: Str -> Bool
exists key = case host_env_get key of
  Some _ -> True
  None -> False

-- Every environment variable, in the order the host reports them.
all :: () -> List (Str, Str)
all () = host_env_vars ()

-- Alias with the same meaning, for symmetry with the other modules.
vars :: () -> List (Str, Str)
vars () = host_env_vars ()

-- The command-line arguments after the program name.
args :: () -> List Str
args () = host_env_args ()

-- The process name (`node` for a server run).
name :: () -> Str
name () = host_env_name ()

-- `"linux" | "darwin" | "win32" | …`
platform :: () -> Str
platform () = host_env_platform ()
