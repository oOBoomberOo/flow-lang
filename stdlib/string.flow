module Flow.String (length, isEmptyStr, joinWith, repeat, padLeft, padRight, words, startsWith, endsWith, indexOf, splitOnce, capitalize, take, drop, isDigit, isAlpha, isAlphaNum, isSpace, isUpper, isLower, toUpper, toLower, trim, upper, lower, split, replace, contains, join, chars, strLen, int, float) where

-- std::string: the primitive operations plus the composed helpers.
-- The prelude re-exports `trim`, `upper`, `lower`, `split`, `replace`,
-- `contains`, `join`, `chars`, `strLen`, `int` and `float`.
import Flow.List (concat, push)

foreign import js unsafe "@trim" {
  s_trim :: Str -> Str
}

foreign import js unsafe "@toUpperCase" {
  s_upper :: Str -> Str
}

foreign import js unsafe "@toLowerCase" {
  s_lower :: Str -> Str
}

foreign import js unsafe "@split" {
  s_split :: Str -> Str -> List Str
}

foreign import js unsafe "@replaceAll" {
  s_replace :: Str -> Str -> Str -> Str
}

foreign import js unsafe "@includes" {
  s_contains :: Str -> Str -> Bool
}

foreign import js unsafe "@join" {
  s_join :: List Str -> Str -> Str
}

foreign import js unsafe "@charAt" {
  s_char_at :: Str -> Int -> Str
}

foreign import js unsafe "#length" {
  s_length :: Str -> Int
}

foreign import js unsafe "parseInt" {
  host_parse_int :: Str -> Int
}

foreign import js unsafe "parseFloat" {
  host_parse_float :: Str -> Float
}

trim :: Str -> Str
trim s = s_trim s

upper :: Str -> Str
upper s = s_upper s

lower :: Str -> Str
lower s = s_lower s

split :: Str -> Str -> List Str
split sep s = s_split s sep

replace :: Str -> Str -> Str -> Str
replace from to s = s_replace s from to

contains :: Str -> Str -> Bool
contains sub s = s_contains s sub

join :: Str -> List Str -> Str
join sep xs = s_join xs sep

chars :: Str -> List Str
chars s = charsFrom s 0 (s_length s) []

-- O(1) string length through the host, instead of walking the characters.
strLen :: Str -> Int
strLen s = s_length s

charsFrom :: Str -> Int -> Int -> List Str -> List Str
charsFrom s i n acc = if i >= n then acc else charsFrom s (i + 1) n (push (s_char_at s i) acc)

int :: Str -> Int
int s = host_parse_int s

float :: Str -> Float
float s = host_parse_float s

-- ---------------------------------------------------------------- helpers
length :: Str -> Int
length s = strLen s

isEmptyStr :: Str -> Bool
isEmptyStr s = strLen s == 0

joinWith :: Str -> List Str -> Str
joinWith sep xs = join sep xs

repeat :: Int -> Str -> Str
repeat n s = if n <= 0 then "" else s + repeat (n - 1) s

padLeft :: Int -> Str -> Str -> Str
padLeft width fill s = if length s >= width then s else repeat (width - length s) fill + s

words :: Str -> List Str
words s = filterBlank (split " " (trim s))

filterBlank :: List Str -> List Str
filterBlank xs = case xs of
  [] -> []
  x : rest -> if isEmptyStr x then filterBlank rest else concat [x] (filterBlank rest)

startsWith :: Str -> Str -> Bool
startsWith prefix s = if length prefix > length s then False else takeStr (length prefix) s == prefix

takeStr :: Int -> Str -> Str
takeStr n s = join "" (take n (chars s))

capitalize :: Str -> Str
capitalize s =
  if isEmptyStr s
    then s
    else upper (join "" (take 1 (chars s))) + join "" (drop 1 (chars s))

take :: Int -> List a -> List a
take n xs =
  if n <= 0
    then []
    else case xs of
      [] -> []
      x : rest -> concat [x] (take (n - 1) rest)

drop :: Int -> List a -> List a
drop n xs =
  if n <= 0
    then xs
    else case xs of
      [] -> []
      _ : rest -> drop (n - 1) rest

-- ---------------------------------------------------------------- padding
foreign import js unsafe "__flow.host.strPadEnd" {
  host_pad_end :: Str -> Int -> Str -> Str
}

padRight :: Int -> Str -> Str -> Str
padRight width fill s = host_pad_end s width fill

-- ---------------------------------------------------------------- searching
foreign import js unsafe "__flow.host.strEndsWith" {
  host_ends_with :: Str -> Str -> Bool
}

foreign import js unsafe "__flow.host.strIndexOf" {
  host_index_of :: Str -> Str -> Int
}

endsWith :: Str -> Str -> Bool
endsWith suffix s = host_ends_with s suffix

-- `-1` when the substring is absent.
indexOf :: Str -> Str -> Int
indexOf needle s = host_index_of s needle

-- Split at the first occurrence of the separator.
splitOnce :: Str -> Str -> Option (Str, Str)
splitOnce sep s =
  let pos = indexOf sep s
  in if pos < 0
     then None
     else Some (sliceStr 0 pos s, sliceStr (pos + length sep) (length s) s)

sliceStr :: Int -> Int -> Str -> Str
sliceStr from to s = joinWith "" (List.take (to - from) (List.drop from (chars s)))

-- ---------------------------------------------------------------- characters
foreign import js unsafe "__flow.host.isDigit" {
  host_is_digit :: Str -> Bool
}

foreign import js unsafe "__flow.host.isAlpha" {
  host_is_alpha :: Str -> Bool
}

foreign import js unsafe "__flow.host.isAlphaNum" {
  host_is_alpha_num :: Str -> Bool
}

foreign import js unsafe "__flow.host.isSpace" {
  host_is_space :: Str -> Bool
}

foreign import js unsafe "__flow.host.isUpper" {
  host_is_upper :: Str -> Bool
}

foreign import js unsafe "__flow.host.isLower" {
  host_is_lower :: Str -> Bool
}

foreign import js unsafe "__flow.host.charUpper" {
  host_char_upper :: Str -> Str
}

foreign import js unsafe "__flow.host.charLower" {
  host_char_lower :: Str -> Str
}

isDigit :: Str -> Bool
isDigit s = host_is_digit s

isAlpha :: Str -> Bool
isAlpha s = host_is_alpha s

isAlphaNum :: Str -> Bool
isAlphaNum s = host_is_alpha_num s

isSpace :: Str -> Bool
isSpace s = host_is_space s

isUpper :: Str -> Bool
isUpper s = host_is_upper s

isLower :: Str -> Bool
isLower s = host_is_lower s

toUpper :: Str -> Str
toUpper s = host_char_upper s

toLower :: Str -> Str
toLower s = host_char_lower s
