module Client (log, now, state) where

-- Client-side authority. These are ordinary functions: each body reaches a
-- client-only primitive, so its placement is client and calling one from server
-- code becomes a cut.
--
--   import Client (log)
--   log "hello"        -- runs in the browser
--   Client.state 0     -- a reactive cell, created in the browser

foreign import js unsafe "console.log" {
  console_write :: Str -> () @client
}

foreign import js unsafe "__flow.host.now" {
  client_now :: () -> Int @client
}

log :: Str -> ()
log msg = console_write msg

now :: () -> Int
now () = client_now ()

-- Cell is neutral: the cell lives wherever it is used.
state :: a -> Cell a
state init = makeCell init
