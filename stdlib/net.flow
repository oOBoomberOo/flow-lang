module Net (NetResult, Net, request, get, post, put, del, getText) where

-- std::net — network requests through the placement-neutral `Net` capability.
--
-- The host provides `fetch` on both sides (browser `fetch`, Node `fetch`).
-- `Net` has no fixed placement: a call is placed by its callback and arguments,
-- so the same API works from client code or server code.
type NetResult = { ok :: Bool, status :: Int, body :: Str, error :: Str }

effect Net @ neutral where
  request :: Str -> Str -> List (Str, Str) -> Str -> (NetResult -> ()) -> ()

foreign import js unsafe "__flow.host.netRequest" {
  host_request :: Str -> Str -> List (Str, Str) -> Str -> (NetResult -> ()) -> ()
}

provide Net where
  request = host_request

request :: Str -> Str -> List (Str, Str) -> Str -> (NetResult -> ()) -> ()
request method url headers body onResult = Net.request method url headers body onResult

get :: Str -> (NetResult -> ()) -> ()
get url onResult = Net.request "GET" url [] "" onResult

post :: Str -> Str -> (NetResult -> ()) -> ()
post url body onResult = Net.request "POST" url [] body onResult

put :: Str -> Str -> (NetResult -> ()) -> ()
put url body onResult = Net.request "PUT" url [] body onResult

del :: Str -> (NetResult -> ()) -> ()
del url onResult = Net.request "DELETE" url [] "" onResult

-- / Convenience for GET: `Some(body)` on success, `None` on failure.
getText :: Str -> (Option Str -> ()) -> ()
getText url onText =
  Net.request "GET" url [] "" (\(result :: NetResult) -> if result.ok then onText (Some result.body) else onText None)
