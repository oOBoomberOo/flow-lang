// std::math

pub fn abs(n: Int) -> Int { if (n < 0) { -n } else { n } }

pub fn minInt(a: Int, b: Int) -> Int { if (a < b) { a } else { b } }

pub fn maxInt(a: Int, b: Int) -> Int { if (a > b) { a } else { b } }

pub fn clamp(n: Int, lo: Int, hi: Int) -> Int { minInt(maxInt(n, lo), hi) }

pub fn sum(xs: List<Int>) -> Int {
  match xs {
    [] => 0,
    [x, ..rest] => x + sum(rest),
  }
}

pub fn product(xs: List<Int>) -> Int {
  match xs {
    [] => 1,
    [x, ..rest] => x * product(rest),
  }
}

pub fn sign(n: Int) -> Int {
  if (n < 0) { -1 } else if (n > 0) { 1 } else { 0 }
}
