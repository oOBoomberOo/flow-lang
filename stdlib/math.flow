module Flow.Math (sqrt, pow, floor, ceil, round, absF, minF, maxF, logF, expF, sinF, cosF, random, pi, e, abs, div, mod, minInt, maxInt, clamp, sum, product, sign, toFloat, toInt, isEven, isOdd, powInt, roundTo) where

-- std::math — Int helpers in Flow, float primitives through the FFI.
-- ---------------------------------------------------------------- float host ops
-- These used to be compiler builtins; now they are ordinary std bindings.
foreign import js unsafe "Math.sqrt" {
  f_sqrt :: Float -> Float
}

foreign import js unsafe "Math.pow" {
  f_pow :: Float -> Float -> Float
}

foreign import js unsafe "Math.floor" {
  f_floor :: Float -> Int
}

foreign import js unsafe "Math.ceil" {
  f_ceil :: Float -> Int
}

foreign import js unsafe "Math.round" {
  f_round :: Float -> Int
}

foreign import js unsafe "Math.abs" {
  f_abs :: Float -> Float
}

foreign import js unsafe "Math.min" {
  f_min :: Float -> Float -> Float
}

foreign import js unsafe "Math.max" {
  f_max :: Float -> Float -> Float
}

foreign import js unsafe "Math.log" {
  f_log :: Float -> Float
}

foreign import js unsafe "Math.exp" {
  f_exp :: Float -> Float
}

foreign import js unsafe "Math.sin" {
  f_sin :: Float -> Float
}

foreign import js unsafe "Math.cos" {
  f_cos :: Float -> Float
}

foreign import js unsafe "Math.random" {
  f_random :: () -> Float
}

foreign import js unsafe "Math.PI" {
  f_pi :: () -> Float
}

foreign import js unsafe "Math.E" {
  f_e :: () -> Float
}

sqrt :: Float -> Float
sqrt x = f_sqrt x

pow :: Float -> Float -> Float
pow x y = f_pow x y

floor :: Float -> Int
floor x = f_floor x

ceil :: Float -> Int
ceil x = f_ceil x

round :: Float -> Int
round x = f_round x

absF :: Float -> Float
absF x = f_abs x

minF :: Float -> Float -> Float
minF a b = f_min a b

maxF :: Float -> Float -> Float
maxF a b = f_max a b

logF :: Float -> Float
logF x = f_log x

expF :: Float -> Float
expF x = f_exp x

sinF :: Float -> Float
sinF x = f_sin x

cosF :: Float -> Float
cosF x = f_cos x

random :: () -> Float
random () = f_random ()

-- Dotted FFI targets are read by nullary functions; these are values.
pi :: Float
pi = f_pi ()

e :: Float
e = f_e ()

-- ---------------------------------------------------------------- Int helpers
abs :: Int -> Int
abs n = if n < 0 then -n else n

div :: Int -> Int -> Int
div a b = a / b

mod :: Int -> Int -> Int
mod a b = a % b

minInt :: Int -> Int -> Int
minInt a b = if a < b then a else b

maxInt :: Int -> Int -> Int
maxInt a b = if a > b then a else b

clamp :: Int -> Int -> Int -> Int
clamp n lo hi = minInt (maxInt n lo) hi

sum :: List Int -> Int
sum xs = case xs of
  [] -> 0
  x : rest -> x + sum rest

product :: List Int -> Int
product xs = case xs of
  [] -> 1
  x : rest -> x * product rest

sign :: Int -> Int
sign n = if n < 0 then -1 else if n > 0 then 1 else 0

-- ---------------------------------------------------------------- conversions
foreign import js unsafe "Number" {
  f_number :: Int -> Float
}

toFloat :: Int -> Float
toFloat n = f_number n

toInt :: Float -> Int
toInt x = floor x

isEven :: Int -> Bool
isEven n = mod n 2 == 0

isOdd :: Int -> Bool
isOdd n = mod n 2 /= 0

-- Integer power, so `2 ^ 10` does not go through floats.
powInt :: Int -> Int -> Int
powInt base exp =
  if exp <= 0 then 1 else base * powInt base (exp - 1)

-- Round to `n` decimal places.
roundTo :: Float -> Int -> Float
roundTo x n =
  let factor = f_number (powInt 10 n)
  in f_number (f_round (x * factor)) / factor
