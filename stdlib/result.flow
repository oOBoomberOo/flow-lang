-- std::result — `Result a e`: a value that either succeeded (`Ok`) or failed (`Err`).
--
-- Use it for parsing and validation, where an error message must survive:
--
--   import Result
--   case Result.parse (int) "12x" of
--     Ok n -> str n
--     Err why -> "bad number: " + why

data Result a e = Ok a | Err e

isOk :: Result a e -> Bool
isOk r = case r of
  Ok _ -> True
  Err _ -> False

isErr :: Result a e -> Bool
isErr r = case r of
  Ok _ -> False
  Err _ -> True

map :: (a -> b) -> Result a e -> Result b e
map f r = case r of
  Ok a -> Ok (f a)
  Err e -> Err e

mapError :: (e -> f) -> Result a e -> Result a f
mapError f r = case r of
  Ok a -> Ok a
  Err e -> Err (f e)

andThen :: (a -> Result b e) -> Result a e -> Result b e
andThen f r = case r of
  Ok a -> f a
  Err e -> Err e

withDefault :: a -> Result a e -> a
withDefault fallback r = case r of
  Ok a -> a
  Err _ -> fallback

toOption :: Result a e -> Option a
toOption r = case r of
  Ok a -> Some a
  Err _ -> None

fromOption :: e -> Option a -> Result a e
fromOption err o = case o of
  Some a -> Ok a
  None -> Err err

-- Both values must succeed; the first failure short-circuits.
map2 :: (a -> b -> c) -> Result a e -> Result b e -> Result c e
map2 f ra rb = case ra of
  Ok a -> case rb of
    Ok b -> Ok (f a b)
    Err e -> Err e
  Err e -> Err e

-- Turn a list of results into a result of a list.
all :: List (Result a e) -> Result (List a) e
all rs =
  let go acc rest = case rest of
        [] -> Ok (reverse acc)
        r : more -> case r of
          Ok a -> go (a : acc) more
          Err e -> Err e
  in go [] rs

-- Pick the first success, remembering the last error if everything failed.
first :: List (Result a e) -> Result a e
first rs = case rs of
  [] -> Err (errPlaceholder ())
  Ok a : _rest -> Ok a
  Err _e : rest -> first rest

-- `first` needs a value of the error type when the list is empty; callers with a
-- sensible default should use `firstOr`.
firstOr :: e -> List (Result a e) -> Result a e
firstOr fallback rs = case rs of
  [] -> Err fallback
  Ok a : _rest -> Ok a
  Err _e : rest -> firstOr fallback rest

errPlaceholder :: () -> e
errPlaceholder () = errPlaceholder ()
