-- std::monad — a small Monad type class for Option and List.
--
-- `>>=` and `do { x <- m; … }` desugar to `Monad.bind`, so importing this module
-- is enough to use the sugar:
--
--   use std::monad::{Monad}
--   Some(2) >>= fn(x) { Some(x + 1) }
--   do { x <- Some(2); y <- Some(3); Some(x + y) }
class Monad f where
  bind :: f a -> (a -> f b) -> f b
  map :: f a -> (a -> b) -> f b

instance Monad Option where
  bind value k = case value of
    None -> None
    Some x -> k x
  map value mapper = case value of
    None -> None
    Some x -> Some (mapper x)

instance Monad List where
  bind value k = case value of
    [] -> []
    x : rest -> concat (k x) (bind rest k)
  map value mapper = case value of
    [] -> []
    x : rest -> concat [mapper x] (map rest mapper)

-- / `pure(value)` for an Option.
some :: a -> Option a
some value = Some value

-- / `pure(value)` for a List.
one :: a -> List a
one value = [value]
