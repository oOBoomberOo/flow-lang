-- std::monad — the Functor / Applicative / Monad / Alternative family.
--
-- Methods dispatch on the type of their receiver, so the same `map` works for
-- `List`, `Option` and `Cell`:
--
--   map xs f          -- List
--   xs |> map f       -- left to right
--   map (Some 1) f    -- Option
--   pure 1            -- the instance follows from the expected type
--
-- `>>=` and `do` notation desugar to `Monad.bind`; `pure` and `return` lift a
-- value. The prelude re-exports these classes, so they are in scope everywhere
-- (and `import Monad (Monad)` still works for code that spells it out).

-- ---------------------------------------------------------------- classes
class Functor f where
  map :: f a -> (a -> b) -> f b

class Functor f => Applicative f where
  pure :: a -> f a
  ap :: f (a -> b) -> f a -> f b

class Applicative f => Monad f where
  bind :: f a -> (a -> f b) -> f b
  return :: a -> f a

-- `empty` and `orElse` are the choice side of the family: `None`/`[]` and the
-- left-biased union of two values.
class Applicative f => Alternative f where
  empty :: f a
  orElse :: f a -> f a -> f a

-- ---------------------------------------------------------------- Option
instance Functor Option where
  map value mapper = case value of
    None -> None
    Some x -> Some (mapper x)

instance Applicative Option where
  pure x = Some x
  ap ff fx = case ff of
    None -> None
    Some f -> map fx f

instance Monad Option where
  bind value k = case value of
    None -> None
    Some x -> k x
  return x = Some x

instance Alternative Option where
  empty = None
  orElse left right = case left of
    None -> right
    Some _ -> left

-- ---------------------------------------------------------------- List
instance Functor List where
  map xs f = case xs of
    [] -> []
    x : rest -> concat [f x] (map rest f)

instance Applicative List where
  pure x = [x]
  ap fs xs = case fs of
    [] -> []
    f : rest -> concat (map xs f) (ap rest xs)

instance Monad List where
  bind xs k = case xs of
    [] -> []
    x : rest -> concat (k x) (bind rest k)
  return x = [x]

instance Alternative List where
  empty = []
  orElse left right = if isEmpty left then right else left

-- ---------------------------------------------------------------- Cell
instance Functor Cell where
  map cell f = makeCell (f (get cell))

instance Applicative Cell where
  pure x = makeCell x
  ap cf cx = makeCell ((get cf) (get cx))

instance Monad Cell where
  bind cell k = k (get cell)
  return x = makeCell x

-- `some(value)` is `pure` for an Option; `one(value)` for a List.
some :: a -> Option a
some value = Some value

one :: a -> List a
one value = [value]
