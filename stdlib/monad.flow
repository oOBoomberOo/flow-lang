-- std::monad — the Monad class for Option, List and Cell.
--
-- `>>=` and `do` notation desugar to `Monad.bind`, and `pure` lifts a value:
--
--   import Monad (Monad)
--   Option.Some 2 >>= (\x -> Option.Some (x + 1))
--   do
--     x <- Option.Some 2
--     y <- Option.Some 3
--     pure (x + y)
--
-- Cells are monads too, so a sequence of reads and writes is just a do block:
--
--   do
--     n <- counter
--     counter := n + 1
--     pure n
class Monad f where
  bind :: f a -> (a -> f b) -> f b
  map :: f a -> (a -> b) -> f b
  pure :: a -> f a

instance Monad Option where
  bind value k = case value of
    None -> None
    Some x -> k x
  map value mapper = case value of
    None -> None
    Some x -> Some (mapper x)
  pure x = Some x

instance Monad List where
  bind value k = go value
    where
      go v = case v of
        [] -> []
        x : rest -> concat (k x) (go rest)
  map value mapper = go value
    where
      go v = case v of
        [] -> []
        x : rest -> concat [mapper x] (go rest)
  pure x = [x]

-- `Cell` is neutral and reactive: binding reads the current value, `pure` makes
-- a fresh cell, and the result is itself a cell that tracks its inputs.
instance Monad Cell where
  bind cell k = k (get cell)
  map cell f = makeCell (f (get cell))
  pure x = makeCell x

-- `some(value)` is `pure` for an Option; `one(value)` for a List.
some :: a -> Option a
some value = Some value

one :: a -> List a
one value = [value]
