module Flow.List (length, isEmptyList, filter, fold, forEach, headOf, take, drop, range, zip, any, all, sortBy, sortInts, sortStrings, contains, indexOfItem, len, isEmpty, push, concat, at, head, tail, reverse, cons) where

-- Flow.List — list transforms, written in Flow itself. Operations take their
-- function/index first and the list last, so `xs |> map f` works.

-- The prelude re-exports the everyday names.
import Flow.Option (Option(..))

-- ---------------------------------------------------------------- primitives
foreign import js unsafe "#length" {
  length_ :: List a -> Int
}

foreign import js unsafe "#index" {
  raw_at :: List a -> Int -> a
}

foreign import js unsafe "@concat" {
  concat_arrays :: List a -> List a -> List a
}

foreign import js unsafe "@slice" {
  slice :: List a -> Int -> List a
}

foreign import js unsafe "@slice" {
  slice_to :: List a -> Int -> Int -> List a
}

foreign import js unsafe "@reverse" {
  reverse_in_place :: List a -> ()
}

len :: List a -> Int
len xs = length_ xs

isEmpty :: List a -> Bool
isEmpty xs = len xs == 0

push :: a -> List a -> List a
push x xs = concat_arrays xs [x]

concat :: List a -> List a -> List a
concat xs ys = concat_arrays xs ys

cons :: a -> List a -> List a
cons x xs = concat_arrays [x] xs

at :: Int -> List a -> a
at i xs = raw_at xs i

head :: List a -> Option a
head xs = if isEmpty xs then None else Some (at 0 xs)

tail :: List a -> List a
tail xs = if isEmpty xs then [] else slice xs 1

reverse :: List a -> List a
reverse xs = do
  let out = slice_to xs 0 (len xs)
  reverse_in_place out
  out

-- ---------------------------------------------------------------- transforms
length :: List a -> Int
length xs = len xs

isEmptyList :: List a -> Bool
isEmptyList xs = isEmpty xs

filter :: (a -> Bool) -> List a -> List a
filter keep xs = case xs of
  [] -> []
  x : rest -> if keep x then concat [x] (filter keep rest) else filter keep rest

fold :: (b -> a -> b) -> b -> List a -> b
fold step init xs = case xs of
  [] -> init
  x : rest -> fold step (step init x) rest

forEach :: (a -> b) -> List a -> ()
forEach f xs = case xs of
  [] -> ()
  x : rest ->
    do
      f x
      forEach f rest

headOf :: List a -> Option a
headOf xs = head xs

take :: Int -> List a -> List a
take n xs =
  if n <= 0
    then []
    else case xs of
      [] -> []
      x : rest -> concat [x] (take (n - 1) rest)

drop :: Int -> List a -> List a
drop n xs =
  if n <= 0
    then xs
    else case xs of
      [] -> []
      _ : rest -> drop (n - 1) rest

range :: Int -> List Int
range n = if n <= 0 then [] else concat (range (n - 1)) [n - 1]

zip :: List a -> List b -> List (a, b)
zip xs ys = case xs of
  [] -> []
  x : xr ->
    case ys of
      [] -> []
      y : yr -> concat [(x, y)] (zip xr yr)

any :: (a -> Bool) -> List a -> Bool
any p xs = case xs of
  [] -> False
  x : rest -> if p x then True else any p rest

all :: (a -> Bool) -> List a -> Bool
all p xs = case xs of
  [] -> True
  x : rest -> if p x then all p rest else False

-- ---------------------------------------------------------------- sorting
-- JS sort, reached through the FFI; the input list is copied first.
foreign import js unsafe "@sort" {
  sort_in_place :: List a -> (a -> a -> Int) -> List a
}

sortBy :: (a -> a -> Int) -> List a -> List a
sortBy cmp xs = sort_in_place (slice_to xs 0 (len xs)) cmp

sortInts :: List Int -> List Int
sortInts xs = sortBy (\(a :: Int) (b :: Int) -> a - b) xs

sortStrings :: List Str -> List Str
sortStrings xs = sortBy (\(a :: Str) (b :: Str) -> if a < b then -1 else if a > b then 1 else 0) xs

contains :: a -> List a -> Bool
contains x xs = any (\(y :: a) -> y == x) xs

indexOfItem :: a -> List a -> Int
indexOfItem x xs = indexFrom x xs 0

indexFrom :: a -> List a -> Int -> Int
indexFrom x xs i = case xs of
  [] -> -1
  y : rest -> if y == x then i else indexFrom x rest (i + 1)
