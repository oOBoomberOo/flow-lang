module List (length, isEmptyList, map, filter, fold, forEach, headOf, take, drop, range, zip, any, all, sortBy, sortInts, sortStrings, contains, indexOfItem) where

-- std::list — list transforms, written in Flow itself.
length :: List a -> Int
length xs = len xs

isEmptyList :: List a -> Bool
isEmptyList xs = isEmpty xs

map :: List a -> (a -> b) -> List b
map xs f = case xs of
  [] -> []
  x : rest -> concat [f x] (map rest f)

filter :: List a -> (a -> Bool) -> List a
filter xs keep = case xs of
  [] -> []
  x : rest -> if keep x then concat [x] (filter rest keep) else filter rest keep

fold :: List a -> b -> (b -> a -> b) -> b
fold xs init step = case xs of
  [] -> init
  x : rest -> fold rest (step init x) step

forEach :: List a -> (a -> b) -> ()
forEach xs f = case xs of
  [] -> ()
  x : rest ->
    do
      f x
      forEach rest f

headOf :: List a -> Option a
headOf xs = head xs

take :: List a -> Int -> List a
take xs n =
  if n <= 0
    then []
    else case xs of
      [] -> []
      x : rest -> concat [x] (take rest (n - 1))

drop :: List a -> Int -> List a
drop xs n =
  if n <= 0
    then xs
    else case xs of
      [] -> []
      _ : rest -> drop rest (n - 1)

range :: Int -> List Int
range n = if n <= 0 then [] else concat (range (n - 1)) [n - 1]

zip :: List a -> List b -> List (a, b)
zip xs ys = case xs of
  [] -> []
  x : xr ->
    case ys of
      [] -> []
      y : yr -> concat [(x, y)] (zip xr yr)

any :: List a -> (a -> Bool) -> Bool
any xs p = case xs of
  [] -> False
  x : rest -> if p x then True else any rest p

all :: List a -> (a -> Bool) -> Bool
all xs p = case xs of
  [] -> True
  x : rest -> if p x then all rest p else False

-- ---------------------------------------------------------------- sorting
-- JS sort, reached through the FFI; the input list is copied first.
foreign import js unsafe "@sort" {
  sort_in_place :: List a -> (a -> a -> Int) -> List a
}

sortBy :: List a -> (a -> a -> Int) -> List a
sortBy xs cmp = sort_in_place (slice_to xs 0 (len xs)) cmp

sortInts :: List Int -> List Int
sortInts xs = sortBy xs (\(a :: Int) (b :: Int) -> a - b)

sortStrings :: List Str -> List Str
sortStrings xs = sortBy xs (\(a :: Str) (b :: Str) -> if a < b then -1 else if a > b then 1 else 0)

contains :: List a -> a -> Bool
contains xs x = any xs (\(y :: a) -> y == x)

indexOfItem :: List a -> a -> Int
indexOfItem xs x = indexFrom xs x 0

indexFrom :: List a -> a -> Int -> Int
indexFrom xs x i = case xs of
  [] -> -1
  y : rest -> if y == x then i else indexFrom rest x (i + 1)
