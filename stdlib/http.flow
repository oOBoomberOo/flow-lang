module Http (RequestObject, Response, Handler, Route, Request, Router, textResponse, htmlResponse, jsonResponse, withStatus, withHeader, redirect, notFoundResponse, route, get, post, put, patch, del, queryParam, pathParam, header, dispatch) where

-- std::http — request/response data, request and routing capabilities, and
-- easy route construction. Everything here is ordinary Flow over host
-- primitives; the host dispatches real HTTP requests to the routes registered
-- by `Router.mount`.
-- ---------------------------------------------------------------- data
type RequestObject = { method :: Str, path :: Str, query :: Str, body :: Str, headers :: List (Str, Str), params :: List (Str, Str) }

type Response = { status :: Int, contentType :: Str, headers :: List (Str, Str), body :: Str }

type Handler = RequestObject -> Response

type Route = { method :: Str, path :: Str, handler :: Handler }

-- ---------------------------------------------------------------- capabilities
-- / The current HTTP request, available anywhere in a server-side handler.
effect Request @ server where
  current :: () -> RequestObject

-- / Route registration. The host reads the routes registered here at startup.
effect Router @ server where
  mount :: List Route -> ()
  notFound :: Handler -> ()

-- ---------------------------------------------------------------- host primitives
foreign import js unsafe "__flow.host.request" {
  host_request :: () -> RequestObject
}

foreign import js unsafe "__flow.host.routes" {
  host_routes :: List Route -> ()
}

foreign import js unsafe "__flow.host.notFound" {
  host_not_found :: Handler -> ()
}

provide Request where
  current = host_request

provide Router where
  mount = host_routes
  notFound = host_not_found

-- ---------------------------------------------------------------- responses
textResponse :: Str -> Response
textResponse body = { status = 200, contentType = "text/plain; charset=utf-8", headers = [], body = body }

htmlResponse :: Str -> Response
htmlResponse body = { status = 200, contentType = "text/html; charset=utf-8", headers = [], body = body }

jsonResponse :: Str -> Response
jsonResponse body =
  { status = 200, contentType = "application/json; charset=utf-8", headers = [], body = body }

withStatus :: Int -> Response -> Response
withStatus status response =
  { status = status, contentType = response.contentType, headers = response.headers, body = response.body }

withHeader :: Response -> Str -> Str -> Response
withHeader response name value =
  { status = response.status, contentType = response.contentType, headers = push response.headers (name, value), body = response.body }

redirect :: Str -> Response
redirect location = withHeader (withStatus 302 (textResponse "")) "location" location

notFoundResponse :: Str -> Response
notFoundResponse message = withStatus 404 (textResponse message)

-- ---------------------------------------------------------------- easy routing
route :: Str -> Str -> Handler -> Route
route method path handler = { method = upper method, path = path, handler = handler }

get :: Str -> Handler -> Route
get path handler = route "GET" path handler

post :: Str -> Handler -> Route
post path handler = route "POST" path handler

put :: Str -> Handler -> Route
put path handler = route "PUT" path handler

patch :: Str -> Handler -> Route
patch path handler = route "PATCH" path handler

del :: Str -> Handler -> Route
del path handler = route "DELETE" path handler

-- ---------------------------------------------------------------- request helpers
queryParam :: RequestObject -> Str -> Option Str
queryParam request name = findQuery (split request.query "&") name

pathParam :: RequestObject -> Str -> Option Str
pathParam request name = findPair request.params name

header :: RequestObject -> Str -> Option Str
header request name = findHeader request.headers (lower name)

findPair :: List (Str, Str) -> Str -> Option Str
findPair pairs name = case pairs of
  [] -> None
  (key, value) : rest -> if key == name then Some value else findPair rest name

findHeader :: List (Str, Str) -> Str -> Option Str
findHeader pairs name = case pairs of
  [] -> None
  (key, value) : rest -> if lower key == name then Some value else findHeader rest name

findQuery :: List Str -> Str -> Option Str
findQuery pairs name = case pairs of
  [] -> None
  pair : rest ->
    case split pair "=" of
      [key, value] -> if key == name then Some value else findQuery rest name
      _ -> findQuery rest name

-- ---------------------------------------------------------------- capability handler
-- / Pure route dispatch over a route list. The host uses the same Route values
-- / for real HTTP dispatch; this is the reusable in-language handler.
dispatch :: List Route -> RequestObject -> Response
dispatch routes request = case findRoute routes request.method request.path of
  Some route -> route.handler request
  None -> notFoundResponse "Not found"

findRoute :: List Route -> Str -> Str -> Option Route
findRoute routes method path = case routes of
  [] -> None
  route : rest ->
    if (route.method == "*" || upper route.method == upper method) && route.path == path
      then Some route
      else findRoute rest method path
