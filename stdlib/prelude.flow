module Prelude (not, cons, Option(..), Store, len, isEmpty, push, concat, head, tail, reverse, trim, upper, lower, split, replace, contains, join, chars, strLen, str, eq, neq, int, float, CellOps, Cell(..), at, makeCell) where

-- std::prelude — the language surface that used to be compiler-injected.
--
-- Every module gets these names automatically (a unit's own declarations and
-- imports win). The primitives are ordinary `unsafe extern js` bindings to the
-- host, so the compiler no longer emits special code for them.
--
-- FFI targets:
--   "Path"    call a global, preserving its receiver  (Math.floor, Date.now)
--   "@name"   method on the first argument            (xs.concat(ys))
--   "#name"   property of the first argument          (xs.length)
--   "#index"  element of the first argument           (xs[i])
-- ---------------------------------------------------------------- types
-- Option is a plain ADT declared here, not a compiler builtin.
data Option a = None | Some a

-- ---------------------------------------------------------------- effects
-- Store is a capability. Client and Server are ordinary modules (std/client,
-- std/server) whose functions are placed by their bodies, so there is no
-- special-cased "Client" or "Server" effect any more.
effect Store @ server where
  get :: Str -> Option Str
  set :: Str -> Str -> ()

-- ---------------------------------------------------------------- host access
foreign import js unsafe "__flow.show" host_show :: a -> Str

foreign import js unsafe "__flow.eq" host_eq :: a -> a -> Bool

foreign import js unsafe "__flow.host.now" host_now :: () -> Int

foreign import js unsafe "__flow.host.secret" host_secret :: Str -> Str

foreign import js unsafe "__flow.host.cell" host_cell :: a -> Cell a

foreign import js unsafe "__flow.get" host_get :: Cell a -> a

foreign import js unsafe "__flow.set" host_set :: Cell a -> a -> ()

foreign import js unsafe "__flow.host.storeGet" host_store_get :: Str -> Option Str

foreign import js unsafe "__flow.host.storeSet" host_store_set :: Str -> Str -> ()

foreign import js unsafe "__flow.host.log" host_log :: Str -> ()

foreign import js unsafe "console.log" console_log :: Str -> ()

foreign import js unsafe "Math.random" math_random :: () -> Float

foreign import js unsafe "parseInt" host_parse_int :: Str -> Int

foreign import js unsafe "parseFloat" host_parse_float :: Str -> Float

-- ---------------------------------------------------------------- lists
foreign import js unsafe "#length" length :: List a -> Int

foreign import js unsafe "#index" at :: List a -> Int -> a

foreign import js unsafe "@concat" concat_arrays :: List a -> List a -> List a

foreign import js unsafe "@slice" slice :: List a -> Int -> List a

foreign import js unsafe "@slice" slice_to :: List a -> Int -> Int -> List a

foreign import js unsafe "@reverse" reverse_in_place :: List a -> ()

len :: List a -> Int
len xs = length xs

isEmpty :: List a -> Bool
isEmpty xs = len xs == 0

push :: List a -> a -> List a
push xs x = concat_arrays xs [x]

concat :: List a -> List a -> List a
concat xs ys = concat_arrays xs ys

head :: List a -> Option a
head xs = if isEmpty xs then None else Some (at xs 0)

tail :: List a -> List a
tail xs = if isEmpty xs then [] else slice xs 1

reverse :: List a -> List a
reverse xs = do
  let out = slice_to xs 0 (len xs)
  reverse_in_place out
  out

-- ---------------------------------------------------------------- strings
foreign import js unsafe "@trim" s_trim :: Str -> Str

foreign import js unsafe "@toUpperCase" s_upper :: Str -> Str

foreign import js unsafe "@toLowerCase" s_lower :: Str -> Str

foreign import js unsafe "@split" s_split :: Str -> Str -> List Str

foreign import js unsafe "@replaceAll" s_replace :: Str -> Str -> Str -> Str

foreign import js unsafe "@includes" s_contains :: Str -> Str -> Bool

foreign import js unsafe "@join" s_join :: List Str -> Str -> Str

foreign import js unsafe "@charAt" s_char_at :: Str -> Int -> Str

foreign import js unsafe "#length" s_length :: Str -> Int

trim :: Str -> Str
trim s = s_trim s

upper :: Str -> Str
upper s = s_upper s

lower :: Str -> Str
lower s = s_lower s

split :: Str -> Str -> List Str
split s sep = s_split s sep

replace :: Str -> Str -> Str -> Str
replace s from to = s_replace s from to

contains :: Str -> Str -> Bool
contains s sub = s_contains s sub

join :: List Str -> Str -> Str
join xs sep = s_join xs sep

chars :: Str -> List Str
chars s = charsFrom s 0 (s_length s) []

-- / Host `#length` for strings (O(1) instead of walking the characters).
strLen :: Str -> Int
strLen s = s_length s

charsFrom :: Str -> Int -> Int -> List Str -> List Str
charsFrom s i n acc = if i >= n then acc else charsFrom s (i + 1) n (push acc (s_char_at s i))

-- ---------------------------------------------------------------- conversions
str :: a -> Str
str x = host_show x

eq :: a -> a -> Bool
eq x y = host_eq x y

not :: Bool -> Bool
not b = if b then False else True

cons :: a -> List a -> List a
cons x xs = concat_arrays [x] xs

neq :: a -> a -> Bool
neq x y = not (host_eq x y)

int :: Str -> Int
int s = host_parse_int s

float :: Str -> Float
float s = host_parse_float s

-- ---------------------------------------------------------------- capabilities
-- The runtime exposes only raw primitives; the capabilities are std code.
makeCell :: a -> Cell a
makeCell init = host_cell init

-- ---------------------------------------------------------------- cells
-- A Cell is neutral: it may live on either side, and its value crosses the
-- boundary as an ordinary cut. Reading and writing go through the host's
-- reactive primitives and carry no client authority of their own.
class CellOps a where
  get :: Cell a -> a
  set :: Cell a -> a -> ()
  update :: Cell a -> (a -> a) -> ()

instance CellOps (Cell a) a where
  get c = host_get c
  set c value = host_set c value
  update c f = host_set c (f (host_get c))

provide Store where
  get key = host_store_get key
  set key value = host_store_set key value
