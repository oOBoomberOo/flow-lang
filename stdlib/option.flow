module Flow.Option where

-- Flow.Option

data Option a = None | Some a

withDefault :: a -> Option a -> a
withDefault fallback o = case o of
  None -> fallback
  Some x -> x

isSome :: Option a -> Bool
isSome o = case o of
  None -> False
  Some _ -> True

isNone :: Option a -> Bool
isNone o = case o of
  None -> True
  Some _ -> False

toList :: Option a -> List a
toList o = case o of
  None -> []
  Some x -> [x]
