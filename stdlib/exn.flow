module Flow.Exn where

-- std::exn — abortive algebraic effects.
--
-- `Exn.fail` suspends; a handler may resume (recovering) or return a fallback,
-- which aborts the rest of the handled computation.
algebraic effect Exn where
  fail :: Str -> a

fail :: Str -> a ! Exn
fail msg = Exn.fail msg

-- / Run `action`, returning `fallback` when it fails.
attempt :: a -> (() -> a ! Exn) -> a
attempt fallback action =
  handle Exn with
    fail msg = fallback
  in action ()

-- / Run `action`, mapping a failure message to a value.
recoverWith :: (Str -> a) -> (() -> a ! Exn) -> a
recoverWith onFail action =
  handle Exn with
    fail msg = onFail msg
  in action ()

-- / Run `action`, recovering at the failure point with `value`.
recover :: a -> (() -> a ! Exn) -> a
recover value action =
  handle Exn with
    fail _msg = resume value
  in action ()
