module Time (nowMs, nowPrecise, elapsedSince, since, pad2, hms, duration) where

-- std::time — timing built on the FFI, not on compiler intrinsics.
foreign import js unsafe "Date.now" date_now :: () -> Int

foreign import js unsafe "globalThis.performance.now" perf_now :: () -> Float

-- / Wall-clock milliseconds since the epoch.
nowMs :: () -> Int
nowMs () = date_now ()

-- / High-resolution milliseconds since the process started (fractional).
nowPrecise :: () -> Float
nowPrecise () = perf_now ()

elapsedSince :: Int -> Int
elapsedSince start = nowMs () - start

since :: Float -> Float
since start = perf_now () - start

pad2 :: Int -> Str
pad2 n = if n < 0 then "00" else if n < 10 then "0" + str n else str n

-- / `hh:mm:ss` for a duration in milliseconds.
hms :: Int -> Str
hms ms = do
  let total = ms / 1000
  pad2 (total / 3600) + ":" + pad2 (total / 60 % 60) + ":" + pad2 (total % 60)

-- / A compact duration: `900ms`, `12s`, `3m 05s`.
duration :: Int -> Str
duration ms =
  if ms < 1000
    then str ms + "ms"
    else if ms < 60000
      then str (ms / 1000) + "s"
      else str (ms / 60000) + "m " + pad2 (ms / 1000 % 60) + "s"
