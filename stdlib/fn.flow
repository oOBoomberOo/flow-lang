-- std::fn — the usual functional combinators, curry-friendly.
identity :: a -> a
identity x = x

constant :: a -> b -> a
constant x _y = x

-- / Flip the two arguments of a binary function.
flip :: (a -> b -> c) -> b -> a -> c
flip f = \(y :: b) (x :: a) -> f x y

-- / `compose(f, g)(x) = f(g(x))` — right-to-left, like Haskell's `(.)`.
compose :: (b -> c) -> (a -> b) -> a -> c
compose f g = \(x :: a) -> f (g x)

-- / `pipe(f, g)(x) = g(f(x))` — left-to-right, matching `|>`.
pipe :: (a -> b) -> (b -> c) -> a -> c
pipe f g = \(x :: a) -> g (f x)

apply :: a -> (a -> b) -> b
apply x f = f x

applyTwice :: (a -> a) -> a -> a
applyTwice f x = f (f x)
