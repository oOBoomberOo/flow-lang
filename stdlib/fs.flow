module Flow.Fs (FileInfo, Fs, readText, tryReadText, writeText, appendText, exists, listDir, makeDir, removeFile, removeDir, stat, tmpDir) where

-- std::fs — server-side filesystem access.
--
-- `Fs` is a server effect capability. The server runtime provides it with
-- Node's fs module; the client bundle never receives these primitives, so a
-- filesystem call is placed on the server by the effect's `@ server` authority.
type FileInfo = { size :: Int, isDir :: Bool, modified :: Int }

effect Fs @ server where
  readText :: Str -> Str
  tryReadText :: Str -> Option Str
  writeText :: Str -> Str -> ()
  appendText :: Str -> Str -> ()
  exists :: Str -> Bool
  listDir :: Str -> List Str
  makeDir :: Str -> ()
  removeFile :: Str -> ()
  removeDir :: Str -> ()
  stat :: Str -> FileInfo
  tmpDir :: () -> Str

foreign import js unsafe "__flow.host.fsReadText" {
  host_read_text :: Str -> Str
}

foreign import js unsafe "__flow.host.fsTryReadText" {
  host_try_read_text :: Str -> Option Str
}

foreign import js unsafe "__flow.host.fsWriteText" {
  host_write_text :: Str -> Str -> ()
}

foreign import js unsafe "__flow.host.fsAppendText" {
  host_append_text :: Str -> Str -> ()
}

foreign import js unsafe "__flow.host.fsExists" {
  host_exists :: Str -> Bool
}

foreign import js unsafe "__flow.host.fsListDir" {
  host_list_dir :: Str -> List Str
}

foreign import js unsafe "__flow.host.fsMakeDir" {
  host_make_dir :: Str -> ()
}

foreign import js unsafe "__flow.host.fsRemoveFile" {
  host_remove_file :: Str -> ()
}

foreign import js unsafe "__flow.host.fsRemoveDir" {
  host_remove_dir :: Str -> ()
}

foreign import js unsafe "__flow.host.fsStat" {
  host_stat :: Str -> FileInfo
}

foreign import js unsafe "__flow.host.fsTmpDir" {
  host_tmp_dir :: () -> Str
}

provide Fs where
  readText = host_read_text
  tryReadText = host_try_read_text
  writeText = host_write_text
  appendText = host_append_text
  exists = host_exists
  listDir = host_list_dir
  makeDir = host_make_dir
  removeFile = host_remove_file
  removeDir = host_remove_dir
  stat = host_stat
  tmpDir = host_tmp_dir

readText :: Str -> Str
readText path = Fs.readText path

tryReadText :: Str -> Option Str
tryReadText path = Fs.tryReadText path

writeText :: Str -> Str -> ()
writeText path contents = Fs.writeText path contents

appendText :: Str -> Str -> ()
appendText path contents = Fs.appendText path contents

exists :: Str -> Bool
exists path = Fs.exists path

listDir :: Str -> List Str
listDir path = Fs.listDir path

makeDir :: Str -> ()
makeDir path = Fs.makeDir path

removeFile :: Str -> ()
removeFile path = Fs.removeFile path

removeDir :: Str -> ()
removeDir path = Fs.removeDir path

stat :: Str -> FileInfo
stat path = Fs.stat path

tmpDir :: () -> Str
tmpDir () = Fs.tmpDir ()
