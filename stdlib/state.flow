module Flow.State where

-- Flow.State — mutable state as an effect.
--
-- `State` suspends at `get`/`put`; `withState`/`runState` install a handler that
-- keeps the current value in a local `Ref`, so the same code runs on the client
-- or the server.
import Flow.Ref (Ref, newRef)

effect State where
  get :: () -> Int
  put :: Int -> ()

get :: () -> Int ! State
get () = State.get ()

put :: Int -> () ! State
put x = State.put x

modify :: (Int -> Int) -> () ! State
modify f = State.put (f (State.get ()))

-- / Run `action` with an initial state and return only its result.
withState :: Int -> (() -> a ! State) -> a
withState init action = do
  let
    cell :: Ref Int
    cell = newRef init
  handle State with
    get () = resume (cell.get ())
    put x = do
      cell.set x
      resume ()
  in action ()

-- / Run `action` and return both its result and the final state.
runState :: Int -> (() -> a ! State) -> (a, Int)
runState init action = do
  let
    cell :: Ref Int
    cell = newRef init
  let value =
        handle State with
          get () = resume (cell.get ())
          put x = do
            cell.set x
            resume ()
        in action ()
  (value, cell.get ())

-- / Run `action` and return only the final state.
execState :: Int -> (() -> a ! State) -> Int
execState init action = do
  let
    cell :: Ref Int
    cell = newRef init
  handle State with
    get () = resume (cell.get ())
    put x = do
      cell.set x
      resume ()
  in action ()
  cell.get ()
