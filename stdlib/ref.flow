module Flow.Ref (Ref, newRef, get, set, modify) where

-- std::ref — a small mutable box that works on either side of the boundary.
--
-- `Ref` is not reactive and not placed: it is a local mutable slot, used to
-- implement stateful algebraic handlers (`std::state`) on the client or server.
type Ref a = { get :: () -> a, set :: a -> () }

foreign import js unsafe "__flow.host.refNew" {
  host_ref_new :: a -> Ref a
}

newRef :: a -> Ref a
newRef init = host_ref_new init

get :: Ref a -> a
get ref = ref.get ()

set :: Ref a -> a -> ()
set ref value = ref.set value

modify :: Ref a -> (a -> a) -> ()
modify ref f = ref.set (f (ref.get ()))
