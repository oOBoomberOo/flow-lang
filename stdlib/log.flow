module Log (info, warn, error, debug, value) where

-- std::log — logging through the host console, built on the FFI.
--
-- No compiler support: `console.log` is an ordinary `unsafe extern js` binding.
foreign import js unsafe "console.log" console_log :: Str -> ()

foreign import js unsafe "console.warn" console_warn :: Str -> ()

foreign import js unsafe "console.error" console_error :: Str -> ()

foreign import js unsafe "console.debug" console_debug :: Str -> ()

info :: Str -> ()
info msg = do
  console_log msg
  ()

warn :: Str -> ()
warn msg = console_warn ("[warn] " + msg)

error :: Str -> ()
error msg = console_error ("[error] " + msg)

debug :: Str -> ()
debug msg = console_debug msg

-- / Log a value with a label, using the structural `str` from the prelude.
value :: Str -> a -> ()
value label x = console_log (label + " = " + str x)
