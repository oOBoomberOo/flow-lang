// std::html — markup helpers and ready-made components.

pub fn classNames(xs: List<Str>) -> Str { join(xs, " ") }

pub fn text(s: Str) -> Html { html { <span class="text">{s}</span> } }

pub fn Card(props: { title: Str, children: Html }) -> Html {
  html {
    <section class="card">
      <h2 class="card-title">{props.title}</h2>
      <div class="card-body">{props.children}</div>
    </section>
  }
}

pub fn Badge(props: { label: Str }) -> Html {
  html { <span class="badge">{props.label}</span> }
}

pub fn Page(props: { title: Str, children: Html }) -> Html {
  html {
    <main class="page">
      <header class="page-header"><h1>{props.title}</h1></header>
      <div class="page-body">{props.children}</div>
    </main>
  }
}

pub fn Button(props: { label: Str, onClick: (Event) -> Unit }) -> Html {
  html {
    <button class="btn" onClick={props.onClick}>{props.label}</button>
  }
}

pub fn Items<a>(props: { items: List<a>, render: (a) -> Html }) -> Html {
  html { <ul class="list">{mapItems(props.items, props.render)}</ul> }
}

fn mapItems<a>(items: List<a>, render: (a) -> Html) -> Html {
  match items {
    [] => html { <i class="empty"></i> },
    [x, ..rest] => html { <li class="list-item">{render(x)}{mapItems(rest, render)}</li> },
  }
}
