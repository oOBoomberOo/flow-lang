-- Traits: type-directed dictionary dispatch, with a generic instance.
type Money = { cents :: Int, currency :: Str }

class Describe a where
  describe :: a -> Str

instance Describe Int where
  describe x = "Int(" + str x + ")"

instance Describe Str where
  describe x = "\"" + x + "\""

instance Describe Money where
  describe m = str m.cents + " " + m.currency

-- A generic instance: dispatches on the element only at the dynamic edge.
instance Describe (List a) a where
  describe xs = "List of " + str (len xs)

class Monoid a where
  empty :: () -> a
  combine :: a -> a -> a

instance Monoid Int where
  empty () = 0
  combine a b = a + b

total :: List Int -> Int
total xs = case xs of
  [] -> Monoid.empty ()
  x : rest -> Monoid.combine x (total rest)

main :: Html
main = do
  let m = { cents = 1250, currency = "USD" }
  <div class="card">
    <h1>{"Traits"}</h1>
    <p class="d1">{"int: "} {Describe.describe 42}</p>
    <p class="d2">{"str: "} {Describe.describe "flow"}</p>
    <p class="d3">{"record: "} {Describe.describe m}</p>
    <p class="d4">{"list: "} {Describe.describe [1, 2, 3]}</p>
    <p class="d5">{"monoid total: "} {total [1, 2, 3, 4]}</p>
  </div>
