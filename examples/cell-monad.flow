-- Cell sugar and monads.
--
-- `c.value` reads a cell, `c := e` writes it, `c += n` / `-=` / `*=` update it
-- in place, and `>>=` (or `do` with `<-`) chains Option and List.
import Monad (Monad)

main :: Html
main = do
  let c = Client.state 1
  c := c.value + 1
  c += 2
  c -= 1
  c *= 3
  c := c.value / 2
  c.update (\x -> x + 10)
  let option = Some 2 >>= \x -> Some 3 >>= \y -> Some (x + y)
  let list = [1, 2] >>= \x -> [10, 20] >>= \y -> [x + y]
  let chained = do
        v <- Some 1
        Some (v * 10)
  <div class="card">
    <h1>Cells and monads</h1>
    <p class="cell">{str c.value}</p>
    <p class="option">{str option}</p>
    <p class="list">{str list}</p>
    <p class="chain">{str chained}</p>
  </div>
