module Counter where


-- Components are functions taking a record and returning Html.
-- A tag starting with an upper-case letter is a component call.
Counter :: { n :: Int, children :: Html } -> Html
Counter props = <p class="count">{"count: "} {props.n}</p>

main :: Html
main = do
  let n = Client.state 0
  <div class="card">
    <h1>{"Counter"}</h1>
    <button class="inc" onClick={\(e :: Event) -> n.set (n.get () + 1)}>{"+1"}</button>
    {<Counter n={n.get ()} />}
  </div>
