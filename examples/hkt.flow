module Hkt where

-- The Functor / Applicative / Monad family lives in Flow.Monad and is
-- re-exported by the prelude. `map` dispatches on the receiver's type
-- constructor, so the same call works for List and Option.
main :: Html
main = do
  let xs = map (\(n :: Int) -> n + 1) [1, 2]
  let o = map (\(n :: Int) -> n + 1) (Some 10)
  <div class="card">
    <h1>{"Higher-kinded Functor"}</h1>
    <p class="hkt">{"list: "} {str xs} {", option: "} {str o}</p>
  </div>
