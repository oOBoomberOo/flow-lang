module Bounds where

-- Generic trait bounds and dictionary dispatch.
--
-- `Show<a>` is implemented for Int, Str and — with a bound — for List<a>.
-- `showAll` and `render` are generic over any `a: Show`; the compiler passes a
-- dictionary for each bounded type parameter.
class Show a where
  show :: a -> Str

instance Show Int where
  show x = "Int(" + str x + ")"

instance Show Str where
  show x = x

showAll :: Show a => List a -> Str
showAll xs = case xs of
  [] -> ""
  x : rest -> Show.show x + ";" + showAll rest

instance Show a => Show (List a) a where
  show xs = showAll xs

render :: Show a => a -> Str
render x = Show.show x

main :: Html
main =
  <div class="card">
    <h1>{"Trait bounds"}</h1>
    <p class="bounded">
      {"int: "}
      {render 42}
      {", str: "}
      {render "hi"}
      {", list: "}
      {render [1, 2]}
    </p>
  </div>
