module Boundary where


-- The `if` lives on the client (its branches produce Html, which is client-only).
-- The then-branch contains a server computation, so the compiler cuts exactly
-- there: the branch is rendered on the client but its data is fetched from the
-- server, and only when the branch is actually taken.
main :: Html
main = do
  let reveal = Client.state False
  <div class="card">
    <h1>{"If across the boundary"}</h1>
    <button class="toggle" onClick={\(e :: Event) -> reveal.set (not (reveal.get ()))}>
      {"toggle the secret"}
    </button>
    {if reveal.get ()
      then <p class="secret">{"server says: "} {str (Server.now ())}</p>
      else <p class="hidden">{"nothing to see here"}</p>}
    <p class="skew">{"server/client clock skew: "} {Server.now () - Client.now ()}</p>
  </div>
