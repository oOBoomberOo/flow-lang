module Adt where

-- Algebraic data types, pattern matching, and exhaustiveness checking.
data Shape = Circle Float | Rect Float Float | Triangle Float Float Float

data Maybe a = Nothing | Just a

pi :: Float
pi = 3.141592653589793

area :: Shape -> Float
area s = case s of
  Circle r -> pi * r * r
  Rect w h -> w * h
  Triangle a b _c -> 0.5 * a * b

describe :: Option Shape -> Str
describe o = case o of
  None -> "no shape"
  Some (Circle r) -> "circle of radius " + str r
  Some (Rect w h) -> "rect " + str w + "x" + str h
  Some (Triangle _ _ _) -> "triangle"

safeDiv :: Int -> Int -> Maybe Int
safeDiv a b = if b == 0 then Nothing else Just (a / b)

view :: List Shape -> Html
view shapes =
  <ul class="shapes">
    <li>{"first: "} {describe (head shapes)}</li>
    <li>
      {"area: "}
      {case head shapes of
        Some s -> area s
        None -> 0.0}
    </li>
  </ul>

main :: Html
main = do
  let shapes = [Rect 3.0 4.0, Circle 2.0]
  <div class="card">
    <h1>{"ADTs"}</h1>
    {view shapes}
    <p>
      {"division: "}
      {case safeDiv 10 2 of
        Just n -> str n
        Nothing -> "undefined"}
    </p>
  </div>
