module Modules where

-- Modules are namespaces: qualified names work without an import, and
-- `import Module (name)` / `import Module as M` bring names into scope.
--
-- Functions take their operation first and the collection last, so
-- `xs |> map f` reads left to right.

import Option (withDefault)

score :: Int -> Str
score n = Option.withDefault "none" (map (\x -> "score " + str x) (Option.Some n))

main :: Html
main = do
  let xs = List.sortBy (\a b -> a - b) [3, 1, 2]
  let doubled = map (\x -> x * 2) (Option.Some 21)
  <div class="card">
    <h1>Namespacing</h1>
    <p>{score 7}</p>
    <p>{str xs}</p>
    <p>{str doubled}</p>
    <p>{str (List.length xs)}</p>
  </div>
