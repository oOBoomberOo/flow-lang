-- Modules are namespaces: qualified names work without an import, and
-- `import Module (name)` / `import Module as M` bring names into scope.
--
-- Collection functions take the collection first, so `xs |> map f` reads
-- left to right.

import Option (withDefault)

score :: Int -> Str
score n = Option.withDefault (map (Option.Some n) (\x -> "score " + str x)) "none"

main :: Html
main = do
  let xs = List.sortBy [3, 1, 2] (\a b -> a - b)
  let doubled = map (Option.Some 21) (\x -> x * 2)
  <div class="card">
    <h1>Namespacing</h1>
    <p>{score 7}</p>
    <p>{str xs}</p>
    <p>{str doubled}</p>
    <p>{str (List.length xs)}</p>
  </div>
