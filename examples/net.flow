module Net where

-- std::net — the Net capability has no fixed placement; this callback uses
-- client state, so the request runs on the client with browser fetch.
import Net (get, NetResult)

main :: Html
main = do
  let status = Client.state "loading"
  get "/__flow/cuts" (\(result :: NetResult) -> status.set (if result.ok then result.body else "error: " + result.error))
  <div class="card">
    <h1>{"Network"}</h1>
    <p class="net">{status.get ()}</p>
  </div>
