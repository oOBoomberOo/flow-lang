-- std::http — request and routing effect capabilities, provided by the host.
--
-- `routes()` is called once at server startup. `Request` is an effect
-- capability exposing the current request; `Router` mounts the routes and the
-- fallback. The client app still compiles as usual, but real HTTP requests are
-- dispatched to these server-side handlers.
import Http (get, post, Router, Request, RequestObject, Response, textResponse, htmlResponse, jsonResponse, queryParam, pathParam, header, notFoundResponse)

routes :: () -> ()
routes () = do
  Router.mount [ get "/" (\(req :: RequestObject) -> do
      let who = case queryParam req "name" of
            Some n -> n
            None -> "world"
      htmlResponse ("<h1>Hello " + who + "</h1>"))
    , get "/health" (\(_req :: RequestObject) -> jsonResponse "{\"ok\":true}")
    , post "/echo" (\(req :: RequestObject) -> textResponse req.body)
    , get "/users/:id" (\(req :: RequestObject) -> case pathParam req "id" of
      Some id -> textResponse ("user " + id)
      None -> textResponse "missing id")
    , get "/whoami" (\(_req :: RequestObject) -> do
      let request = Request.current ()
      textResponse (request.method + " " + request.path))
    , get "/agent" (\(req :: RequestObject) -> case header req "x-test" of
      Some value -> textResponse ("header " + value)
      None -> textResponse "no header")
    ]
  Router.notFound (\(req :: RequestObject) -> notFoundResponse ("no route for " + req.path))

main :: Html
main =
  <div class="app">
    <h1>{"Flow HTTP"}</h1>
    <p>{"The client bundle is still served at /app.js."}</p>
  </div>
