module Fp where

-- Functional style: inferred lambda params, currying, pipes and combinators.
import Fn (compose, flip, pipe, applyTwice)
import List (filter, range)

add :: Int -> Int -> Int
add a b = a + b

sub :: Int -> Int -> Int
sub a b = a - b

mul :: Int -> Int -> Int
mul a b = a * b

main :: Html
main = do
  let inc = add 1
  let ten = inc 9
  let chained = (add 1) 2
  let xs = range 6
  let evens = filter (\x -> x % 2 == 0) xs
  let doubled = map (\x -> x * 2) xs
  let sum = map (\x -> x * 1) (map inc xs)
  let piped = mul (add 3 1) 2
  let composed = compose (\x -> x + 1) (\x -> x * 2)
  let flipped = flip sub
  let twice = applyTwice (\x -> x + 3) 1
  let expressionBody = add 4
  let applied = expressionBody 1
  let addLocal = \(a :: Int) (b :: Int) -> a + b
  let plusTen = addLocal 10
  let localPartial = plusTen 5
  <div class="card">
    <h1>{"Currying and pipes"}</h1>
    <p class="values">
      {str ten + " " + str chained + " " + str piped + " " + str (composed 3) + " " + str (flipped 10 3) + " " + str twice + " " + str applied + " " + str localPartial}
    </p>
    <p class="lists">{str evens + " " + str doubled + " " + str sum}</p>
  </div>
