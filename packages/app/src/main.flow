module App.Main where

import Flow.Client
import Flow.Server
import Flow.Serialize
import Flow.Http
import Flow.Cell
import Flow.Exn (Exn)

import App.Todo
import Math (div)

main :: ()
main = do
  Http.serve 
    { page = router
    , routes = []
    }

router :: RequestObject -> Html
router = 
  (Option.withDefault fallbackPage) 
  . (map \(req, page) -> page req) 
  . (matchPage pages)


pages :: List PageRoute
pages = 
  [ page "/" homePage
  , page "/about" aboutPage
  ]

type TodoId = Int

effect TodoList where
  addItem :: Str -> TodoId
  removeItem :: TodoId -> ()
  toggleItem :: TodoId -> ()
  getItems :: () -> List Todo

type State = { todos :: List Todo, idCounter :: Int }

state :: Cell State
state = Server.state $ { todos = [], idCounter = 0}

updateTodo :: Cell State -> (List Todo -> List Todo) -> ()
updateTodo state updateFn = state := { todos = updateFn state.value.todos, idCounter = state.value.idCounter }

provide TodoList where
  addItem title = do
      state := { todos = Todo.addTodo newItem state.value.todos, idCounter = nextId }
      nextId
    where
      nextId = state.value.idCounter + 1
      newItem = Todo { id = nextId, title = title, completed = False }

  removeItem todoId =
    updateTodo state $ Todo.removeTodo todoId

  toggleItem todoId =
    updateTodo state $ Todo.toggleTodo todoId

  getItems () =
    state.value.todos

homePage req = 
  <div>
    <input type="text" placeholder="Add a todo" value={draft.value} onChange={\(e :: Event) -> draft := e.target.value}/>
    <button onClick={\(e :: Event) -> do
        TodoList.addItem draft.value
        draft := ""
    }>{"+"}</button>

    {
      map (TodoList.getItems ()) $ \todo ->
        <div>
          <button onClick={\(e :: Event) -> TodoList.removeItem todo.id}>{"Remove"}</button>
          <input type="checkbox" checked={todo.completed} onChange={\(e :: Event) -> TodoList.toggleItem todo.id} />
          <span>{todo.title}</span>
        </div>
    }
  </div>

  where
    draft = Client.state ""

aboutPage req = <h1>About Page</h1>

fallbackPage = <h1>Page not Found</h1>
