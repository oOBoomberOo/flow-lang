module Util (Priority(..), priorityLabel, describe, priorities) where

-- A module of the `demo` package. `pub` marks the exported surface; everything
-- else stays private to this file.
data Priority = Low | High

priorityLabel :: Priority -> Str
priorityLabel p = case p of
  Low -> "low"
  High -> "high"

-- Not exported: importing this from another module is a compile error.
secretSauce :: () -> Str
secretSauce () = "sssh"

describe :: Priority -> Str
describe p = priorityLabel p + " (" + secretSauce () + ")"

priorities :: () -> List Priority
priorities () = [High, Low]
