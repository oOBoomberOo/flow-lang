{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Flow",
  "scopeName": "source.flow",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#module" },
    { "include": "#imports" },
    { "include": "#signatures" },
    { "include": "#declarations" },
    { "include": "#html" },
    { "include": "#keywords" },
    { "include": "#constructors" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-dash.flow", "match": "--.*$" },
        { "name": "comment.block.flow", "begin": "\\{-", "end": "-\\}", "patterns": [
          { "name": "comment.block.flow", "begin": "\\{-", "end": "-\\}" }
        ]}
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.double.flow", "begin": "\"", "end": "\"", "patterns": [
          { "name": "constant.character.escape.flow", "match": "\\\\." }
        ]}
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.flow", "match": "\\b\\d+\\.\\d+\\b" },
        { "name": "constant.numeric.integer.flow", "match": "\\b\\d+\\b" }
      ]
    },
    "module": {
      "patterns": [
        {
          "name": "meta.module.flow",
          "match": "^\\s*(module)\\s+([A-Z][A-Za-z0-9_.]*)",
          "captures": {
            "1": { "name": "keyword.control.module.flow" },
            "2": { "name": "entity.name.namespace.flow" }
          }
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "name": "meta.import.flow",
          "begin": "^\\s*(import)\\b",
          "beginCaptures": { "1": { "name": "keyword.control.import.flow" } },
          "end": "$",
          "patterns": [
            { "name": "keyword.other.as.flow", "match": "\\bas\\b" },
            { "name": "punctuation.separator.namespace.flow", "match": "\\." },
            { "name": "entity.name.namespace.flow", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" },
            { "name": "variable.other.flow", "match": "\\b[a-z][A-Za-z0-9_']*\\b" },
            { "name": "punctuation.definition.import.flow", "match": "[(),]" }
          ]
        }
      ]
    },
    "signatures": {
      "patterns": [
        {
          "match": "^\\s*([a-z_][A-Za-z0-9_']*)\\s*(::)",
          "captures": {
            "1": { "name": "entity.name.function.flow" },
            "2": { "name": "keyword.operator.type-signature.flow" }
          }
        },
        {
          "match": "^\\s*([A-Z][A-Za-z0-9_]*)\\s*(::)",
          "captures": {
            "1": { "name": "entity.name.type.flow" },
            "2": { "name": "keyword.operator.type-signature.flow" }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(data)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.data.flow" },
            "2": { "name": "entity.name.type.flow" }
          }
        },
        {
          "match": "\\b(type)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.flow" },
            "2": { "name": "entity.name.type.flow" }
          }
        },
        {
          "match": "\\b(class|instance|effect|algebraic|provide|foreign)\\b",
          "name": "storage.type.flow"
        },
        {
          "match": "^([a-z_][A-Za-z0-9_']*)(?=\\s+[a-z_(\\[\\{])",
          "captures": { "1": { "name": "entity.name.function.flow" } }
        }
      ]
    },
    "html": {
      "patterns": [
        {
          "name": "meta.tag.flow",
          "begin": "(<)([a-z][A-Za-z0-9-]*)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.flow" },
            "2": { "name": "entity.name.tag.flow" }
          },
          "end": "(/?>)",
          "endCaptures": { "1": { "name": "punctuation.definition.tag.end.flow" } },
          "patterns": [
            { "name": "entity.other.attribute-name.flow", "match": "\\b[A-Za-z_][A-Za-z0-9_-]*\\b(?=\\s*=)" },
            { "name": "keyword.other.event.flow", "match": "\\bon[A-Z][A-Za-z]*\\b" },
            { "include": "#strings" },
            { "name": "punctuation.section.embedded.flow", "begin": "\\{", "end": "\\}", "patterns": [{ "include": "$self" }] }
          ]
        },
        {
          "name": "meta.tag.component.flow",
          "begin": "(<)([A-Z][A-Za-z0-9_]*)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.flow" },
            "2": { "name": "entity.name.tag.flow" }
          },
          "end": "(/?>)",
          "endCaptures": { "1": { "name": "punctuation.definition.tag.end.flow" } },
          "patterns": [
            { "name": "entity.other.attribute-name.flow", "match": "\\b[A-Za-z_][A-Za-z0-9_-]*\\b(?=\\s*=)" },
            { "include": "#strings" },
            { "name": "punctuation.section.embedded.flow", "begin": "\\{", "end": "\\}", "patterns": [{ "include": "$self" }] }
          ]
        },
        {
          "name": "meta.tag.fragment.flow",
          "match": "(<>)(</>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.begin.flow" },
            "2": { "name": "punctuation.definition.tag.end.flow" }
          }
        },
        {
          "name": "meta.tag.closing.flow",
          "match": "(</)([a-zA-Z][A-Za-z0-9-]*)(>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.begin.flow" },
            "2": { "name": "entity.name.tag.flow" },
            "3": { "name": "punctuation.definition.tag.end.flow" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow",
          "match": "\\b(if|then|else|case|of|do)\\b"
        },
        {
          "name": "keyword.other.flow",
          "match": "\\b(module|import|as|data|type|class|instance|where|let|in|effect|algebraic|provide|handle|with|for|foreign|resume)\\b"
        },
        {
          "name": "constant.language.flow",
          "match": "\\b(True|False)\\b"
        }
      ]
    },
    "constructors": {
      "patterns": [
        { "name": "variable.other.constant.flow", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "functions": {
      "patterns": [
        { "name": "variable.function.flow", "match": "\\b[a-z_][A-Za-z0-9_']*\\b(?=\\s+[A-Za-z_(\\[\\{])" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.flow", "match": ">>=|->|=>|==|/=|<=|>=|&&|\\|\\||\\+=|-=|\\*=|:=|\\+\\+|--|<-|\\|>|<\\||\\$|\\.|[:+*/%<>=!|@^&~-]+" }
      ]
    }
  }
}
