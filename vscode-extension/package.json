{
  "name": "flow-language",
  "displayName": "Flow",
  "description": "Flow: tierless web language with a type-inferred client/server boundary — syntax highlighting, diagnostics, hover and per-cut boundary colouring.",
  "version": "0.18.0",
  "publisher": "flow-lang",
  "license": "MIT",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages", "Linters"],
  "activationEvents": ["onLanguage:flow", "workspaceContains:**/*.flow"],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "flow",
        "aliases": ["Flow", "flow"],
        "extensions": [".flow"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "flow",
        "scopeName": "source.flow",
        "path": "./syntaxes/flow.tmLanguage.json"
      }
    ],
    "semanticTokenModifiers": [
      { "id": "client", "description": "A symbol that runs on the client." },
      { "id": "server", "description": "A symbol that runs on the server." },
      { "id": "cut", "description": "A symbol inside a cut: code the compiler moved across the tier boundary." },
      { "id": "crossing", "description": "A symbol inside an expression that mixes client and server values." },
      { "id": "dependency", "description": "A free variable a cut carries across the boundary; it keeps the colour of the scope it belongs to." },
      { "id": "cut1", "description": "Cut palette slot 1." },
      { "id": "cut2", "description": "Cut palette slot 2." },
      { "id": "cut3", "description": "Cut palette slot 3." },
      { "id": "cut4", "description": "Cut palette slot 4." },
      { "id": "cut5", "description": "Cut palette slot 5." },
      { "id": "cut6", "description": "Cut palette slot 6." },
      { "id": "cut7", "description": "Cut palette slot 7." },
      { "id": "cut8", "description": "Cut palette slot 8." },
      { "id": "cut9", "description": "Cut palette slot 9." },
      { "id": "cut10", "description": "Cut palette slot 10." },
      { "id": "cut11", "description": "Cut palette slot 11." },
      { "id": "cut12", "description": "Cut palette slot 12." }
    ],
    "commands": [
      { "command": "flow.explain", "title": "Flow: Explain Boundary" },
      { "command": "flow.toggleBoundary", "title": "Flow: Toggle Boundary Colouring" },
      { "command": "flow.restart", "title": "Flow: Restart Language Server" },
      { "command": "flow.importSymbol", "title": "Flow: Import Symbol" },
      { "command": "flow.moveSymbol", "title": "Flow: Move Symbol to Module" },
      { "command": "flow.organizeImports", "title": "Flow: Organize Imports" }
    ],
    "configuration": {
      "title": "Flow",
      "properties": {
        "flow.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to src/lsp/server.ts. Empty = auto-detect: a workspace compiler checkout first, then the bundled copy."
        },
        "flow.useWorkspaceServer": {
          "type": "boolean",
          "default": true,
          "description": "When the open folder is a Flow compiler checkout, run its src/lsp/server.ts (the code you are editing) instead of the server bundled with the extension."
        },
        "flow.devWatch": {
          "type": "boolean",
          "default": true,
          "description": "Restart the language server automatically when files under the checkout's src/**.ts or registry/**.flow change. Applies only when running a compiler checkout, not the bundled server."
        },
        "flow.cutPalette": {
          "type": "array",
          "items": { "type": "string" },
          "default": [
            "#c678dd", "#56b6c2", "#e5c07b", "#e06c75", "#98c379", "#d19a66",
            "#d16d9e", "#89ddff", "#b48ead", "#a3be8c", "#ebcb8b", "#7f9cf5"
          ],
          "description": "Marker colours for cuts, cycled when a file has more cuts than entries. Symbol colours are set by editor.semanticTokenColorCustomizations (the extension supplies matching defaults)."
        },
        "flow.crossingColor": {
          "type": "string",
          "default": "rgba(176, 176, 176, 0.7)",
          "description": "Colour of the dotted marker for a cross-tier expression resolved without a whole cut."
        },
        "flow.enableDecorations": {
          "type": "boolean",
          "default": true,
          "description": "Colour boundary symbols and mark cuts with an underline, gutter arrow and overview-ruler mark."
        }
      }
    }
  },
  "configurationDefaults": {
    "[flow]": {
      "editor.semanticHighlighting.enabled": true,
      "editor.quickSuggestions": { "other": true, "comments": false, "strings": false },
      "editor.suggestOnTriggerCharacters": true,
      "editor.formatOnType": true,
      "editor.inlayHints.enabled": "on"
    },
    "editor.semanticTokenColorCustomizations": {
      "rules": {
        "*.client": { "foreground": "#61afef" },
        "*.server": { "foreground": "#e0af68" },
        "*.cut": { "italic": true },
        "*.cut1": { "foreground": "#c678dd" },
        "*.cut2": { "foreground": "#56b6c2" },
        "*.cut3": { "foreground": "#e5c07b" },
        "*.cut4": { "foreground": "#e06c75" },
        "*.cut5": { "foreground": "#98c379" },
        "*.cut6": { "foreground": "#d19a66" },
        "*.cut7": { "foreground": "#d16d9e" },
        "*.cut8": { "foreground": "#89ddff" },
        "*.cut9": { "foreground": "#b48ead" },
        "*.cut10": { "foreground": "#a3be8c" },
        "*.cut11": { "foreground": "#ebcb8b" },
        "*.cut12": { "foreground": "#7f9cf5" },
        "*.crossing": { "foreground": "#9aa5b1" },
        "*.dependency": { "underline": true }
      }
    }
  },
  "scripts": { "vscode:prepublish": "node -e \"process.exit(0)\"" }
}
