(* Flow — grammar (Haskell-style surface syntax)
   Layout is significant: `where`, `let`, `of`, `do` and `with` open an implicit
   block at the indentation of the next token. A line that starts at or left of
   that indentation inserts a virtual `;` (same column) or closes the block
   (smaller column). Brackets, list literals, records and `{expr}` holes suspend
   layout. *)

program         = [ module-header ] { declaration } ;
module-header   = 'module' module-name [ '(' export-list ')' ] 'where' ;
module-name     = con { '.' con } ;
export-list     = export { ',' export } ;
export          = ( identifier | con [ '(' [ '..' | con { ',' con } ] ')' ] ) ;

declaration     = import-decl | data-decl | type-decl | class-decl | instance-decl
                | effect-decl | provide-decl | foreign-decl
                | signature | clause ;

import-decl     = 'import' module-name [ 'as' con ]
                  [ '(' import-item { ',' import-item } ')' ] ;
import-item     = ( identifier | con ) [ 'as' identifier ] ;

data-decl       = 'data' con { var } '=' constructor { '|' constructor } ;
constructor     = con { atype } ;
type-decl       = 'type' con { var } '=' ( type | record-fields ) ;
record-fields   = '{' [ field { ',' field } ] '}' ;
field           = identifier '::' type ;

class-decl      = 'class' [ context '=>' ] con { var } 'where' { signature } ;
instance-decl   = 'instance' [ context '=>' ] con atype { atype } 'where' { clause } ;
context         = class-assert { ',' class-assert } | '(' class-assert { ',' class-assert } ')' ;
class-assert    = con var ;

effect-decl     = [ 'algebraic' ] 'effect' con [ '@' placement ] 'where' { signature } ;
provide-decl    = 'provide' con [ 'for' atype ] 'where' { clause } ;
foreign-decl    = 'foreign' 'import' 'js' 'unsafe' str signature ;

signature       = identifier '::' [ context '=>' ] type [ '!' effect-row ] ;
clause          = identifier { apat } ( '=' expr | guards ) [ 'where' block ] ;
guards          = { '|' expr '=' expr } ;
block           = { clause } ;                      (* layout *)

placement       = 'client' | 'server' ;
effect-row      = con { ',' con } | '{' [ con { ',' con } ] '}' ;

(* ---------------------------------------------------------------- types *)

type            = btype [ '@' placement ] [ '->' type [ '!' effect-row ] ] ;
btype           = atype { atype } ;
atype           = con { '.' con } | var
                | '(' ')' | '(' type { ',' type ')' | '[' type ']'
                | record-fields ;

(* ---------------------------------------------------------------- expressions *)

expr            = op-expr [ '::' type ] [ assign-op expr ] ;
assign-op       = ':=' | '+=' | '-=' | '*=' ;
op-expr         = operand { operator operand } ;
operator        = infix-op | '`' ( identifier | con ) '`' ;
infix-op        = '$' | '|>' | '<|' | '>>=' | '.' | ':' | '++'
                | '||' | '&&' | '==' | '/=' | '<' | '<=' | '>' | '>='
                | '+' | '-' | '*' | '/' | '%' ;

operand         = '-' operand | app ;
app             = postfix { atype-arg } | postfix block-arg ;
block-arg       = lambda | 'do' do-block | 'case' case-block
                | 'if' if-expr | 'let' let-expr | 'handle' handle-expr ;
postfix         = primary { '.' ( identifier | num ) } ;

primary         = literal | identifier | con
                | '(' expr ')' | '(' expr ',' expr { ',' expr } ')'
                | section
                | '[' [ expr { ',' expr } ] ']'
                | '{' [ rec-field { ',' rec-field } ] '}'
                | '\\' apat { apat } '->' expr
                | '\\' 'case' case-block
                | 'if' expr 'then' expr 'else' expr
                | 'case' expr 'of' case-block
                | 'let' block 'in' expr
                | 'do' do-block
                | 'handle' con 'with' block 'in' expr
                | markup ;

section         = '(' operator expr ')' | '(' expr operator ')' | '(' operator ')' ;
literal         = int | float | str | 'True' | 'False' | '()' ;
rec-field       = identifier [ '=' expr ] ;

case-block      = { alt } ;                         (* layout *)
alt             = pat [ '|' expr ] '->' expr [ 'where' block ] ;
do-block        = { stmt } ;                        (* layout *)
stmt            = pat '<-' expr | 'let' block | expr ;

lambda          = '\\' apat { apat } '->' expr ;
if-expr         = 'if' expr 'then' expr 'else' expr ;
let-expr        = 'let' block 'in' expr ;

(* ---------------------------------------------------------------- patterns *)

pat             = pat10 { ':' pat } ;
pat10           = con { apat } | apat ;
apat            = var | '_' | literal
                | con | '(' pat ')' | '(' pat { ',' pat } ')'
                | '[' [ pat { ',' pat } ] ']'
                | '{' [ pat-field { ',' pat-field } ] '}' ;
pat-field       = identifier [ '=' pat ] ;

(* ---------------------------------------------------------------- markup *)

markup          = element | fragment ;
fragment        = '<>' { markup-node } '</>' ;
element         = '<' tag { attribute } ( '/>' | '>' { markup-node } '</' tag '>' ) ;
tag             = identifier | con ;
attribute       = identifier [ '=' ( str | '{' expr '}' ) ] ;
markup-node     = element | fragment | '{' expr '}' | text ;

(* ---------------------------------------------------------------- lexical *)

comment         = '--' { any-except-newline } | '{-' ... '-}' ;   (* block comments nest *)
keyword         = 'module' | 'import' | 'as' | 'data' | 'type' | 'class' | 'instance'
                | 'where' | 'let' | 'in' | 'if' | 'then' | 'else' | 'case' | 'of'
                | 'do' | 'effect' | 'algebraic' | 'provide' | 'handle' | 'with'
                | 'for' | 'foreign' ;
